*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# IDE-specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
